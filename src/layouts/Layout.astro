---
import { Font } from 'astro:assets'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import StatusLive from '@components/StatusLive.astro'
import { SITE } from '@lib/site'
import '@styles/globals.css'

interface Props {
  title?: string
  description?: string
  /** Pages that own their full layout (the homepage) opt out of the shell padding. */
  bare?: boolean
}

const { title, description = SITE.description } = Astro.props

const pageTitle = title
  ? `${title} — ${SITE.name}`
  : `${SITE.name} — Software for the Modern Age`
const canonical = new URL(Astro.url.pathname, SITE.url).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — Lab`}
      href="/rss.xml"
    />
    <meta name="theme-color" content="#f0dbb7" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-jetbrains" preload />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="label sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <StatusLive />
  </body>
</html>
