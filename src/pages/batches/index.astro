---
import Layout from '@layouts/Layout.astro'
import ProgramCard from '@components/ProgramCard.astro'
import RibbonLoop from '@components/art/RibbonLoop.astro'
import { getPrograms } from '@lib/programs'

const programs = await getPrograms()
---

<Layout
  title="Batches"
  description="Software the studio has shipped and is shipping — what each one is, and how it's built."
>
  <!--
    Three stacked rows rather than one padded block: the ribbon has to bleed to
    both edges, and it cannot do that from inside the padding without a negative
    margin that has to be kept in step with it. As its own full-width row it just
    spans, and the copy above and below keeps the section's padding.
  -->
  <section class="overflow-hidden border-b">
    <div class="px-6 pt-12 lg:px-8 lg:pt-16">
      <p class="label text-red-deep">Selected batches</p>
      <h1 class="display mt-3 text-[clamp(2.75rem,9vw,6rem)]">
        What the studio<br />has shipped.
      </h1>
    </div>

    {/*
      The coil lives at the right of the artwork, so on narrow screens the whole
      thing is scaled up and pulled left until its right edge is flush with the
      frame — 150% wide against -50% of margin, which cancel exactly at any
      width. The coil stays in view at its full size and the run-in bands are
      what gets cropped, which is the right way round: they are stripes, and it
      is the shape.
    */}
    <RibbonLoop class="pointer-events-none -ml-[50%] mt-10 block w-[150%] max-w-none lg:ml-0 lg:mt-14 lg:w-full" />

    <div class="px-6 pb-12 lg:px-8 lg:pb-16">
      <p class="label mt-10 max-w-[46ch] text-blue lg:mt-14">
        Small, useful things. Each one is a real product with a real URL — not a
        case study for something that never launched.
      </p>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-3">
    {programs.map((program) => <ProgramCard program={program} />)}
  </div>
</Layout>
