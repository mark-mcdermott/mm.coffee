---
import { render } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import BatchArt from '@components/BatchArt.astro'
import { getBatches, batchNumber, accentText } from '@lib/batches'

export async function getStaticPaths() {
  const batches = await getBatches()
  return batches.map((batch) => ({
    params: { slug: batch.id },
    props: { batch },
  }))
}

const { batch } = Astro.props
const { title, order, tagline, summary, stack, url, repo, status, accent, art } =
  batch.data
const { Content } = await render(batch)
---

<Layout title={title} description={summary}>
  <article>
    <header class="border-b px-6 py-12 lg:px-8 lg:py-16">
      <p class:list={['label', accentText(accent)]}>
        Batch {batchNumber(order)}
      </p>
      <h1 class="display display-title mt-3 text-[clamp(2.75rem,10vw,7rem)]">{title}</h1>
      <p class="label mt-4 max-w-[52ch] text-blue">{tagline}</p>
    </header>

    <div class="grid lg:grid-cols-[1fr_20rem]">
      <div class="border-b px-6 py-10 lg:border-b-0 lg:border-r lg:px-8">
        <BatchArt art={art} class="mb-10 h-56 lg:h-72" />

        {/*
          Widened ~13%. `ch` resolves against this div's own 13px, not the 14.4px
          the paragraphs are set at, so the number is not the measure it looks
          like: 70ch is 547px, which is 63 characters of body text per line, up
          from 55. Deliberately still far narrower than the column it sits in —
          the empty space to its right is part of the composition, not room going
          spare.
        */}
        <div
          class="max-w-[70ch] space-y-5 [&_h2]:display [&_h2]:mt-10 [&_h2]:text-[1.75rem] [&_p]:text-[0.9rem] [&_p]:leading-[1.75]"
        >
          <Content />
        </div>
      </div>

      <aside class="px-6 py-10 lg:px-8">
        <dl class="space-y-6">
          <div>
            <dt class="label opacity-45">Status</dt>
            <dd class="label mt-1">{status}</dd>
          </div>

          <div>
            <dt class="label opacity-45">Stack</dt>
            <dd class="label mt-1">
              <ul>{stack.map((item) => <li>{item}</li>)}</ul>
            </dd>
          </div>

          <div>
            <dt class="label opacity-45">Live</dt>
            <dd class="label mt-1">
              <a href={url} class="underline hover:text-red-deep">
                {url.replace(/^https?:\/\//, '')}
              </a>
            </dd>
          </div>

          {
            repo && (
              <div>
                <dt class="label opacity-45">Source</dt>
                <dd class="label mt-1">
                  <a href={repo} class="underline hover:text-red-deep">
                    {repo.replace(/^https?:\/\/(www\.)?github\.com\//, '')}
                  </a>
                </dd>
              </div>
            )
          }
        </dl>

        <a
          href={url}
          class="label mt-10 cta inline-flex items-center gap-2 px-5 py-3"
        >
          Visit {title}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </div>

    <nav class="border-t px-6 py-6 lg:px-8" aria-label="Batches">
      <a href="/batches" class="label hover:text-red-deep">&larr; All batches</a>
    </nav>
  </article>
</Layout>
