---
import { render } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import ProgramArt from '@components/ProgramArt.astro'
import { getPrograms, programNumber, accentText } from '@lib/programs'

export async function getStaticPaths() {
  const programs = await getPrograms()
  return programs.map((program) => ({
    params: { slug: program.id },
    props: { program },
  }))
}

const { program } = Astro.props
const { title, order, tagline, summary, stack, url, repo, status, accent, art } =
  program.data
const { Content } = await render(program)
---

<Layout title={title} description={summary}>
  <article>
    <header class="border-b px-6 py-12 lg:px-8 lg:py-16">
      <p class:list={['label', accentText(accent)]}>
        Program {programNumber(order)}
      </p>
      <h1 class="display mt-3 text-[clamp(2.75rem,10vw,7rem)]">{title}</h1>
      <p class="label mt-4 max-w-[52ch] text-blue">{tagline}</p>
    </header>

    <div class="grid lg:grid-cols-[1fr_20rem]">
      <div class="border-b px-6 py-10 lg:border-b-0 lg:border-r lg:px-8">
        <ProgramArt art={art} class="mb-10 h-56 lg:h-72" />

        <div
          class="max-w-[62ch] space-y-5 [&_h2]:display [&_h2]:mt-10 [&_h2]:text-[1.75rem] [&_p]:text-[0.9rem] [&_p]:leading-[1.75]"
        >
          <Content />
        </div>
      </div>

      <aside class="px-6 py-10 lg:px-8">
        <dl class="space-y-6">
          <div>
            <dt class="label opacity-45">Status</dt>
            <dd class="label mt-1">{status}</dd>
          </div>

          <div>
            <dt class="label opacity-45">Stack</dt>
            <dd class="label mt-1">
              <ul>{stack.map((item) => <li>{item}</li>)}</ul>
            </dd>
          </div>

          <div>
            <dt class="label opacity-45">Live</dt>
            <dd class="label mt-1">
              <a href={url} class="underline hover:text-red-deep">
                {url.replace(/^https?:\/\//, '')}
              </a>
            </dd>
          </div>

          {
            repo && (
              <div>
                <dt class="label opacity-45">Source</dt>
                <dd class="label mt-1">
                  <a href={repo} class="underline hover:text-red-deep">
                    {repo.replace(/^https?:\/\/(www\.)?github\.com\//, '')}
                  </a>
                </dd>
              </div>
            )
          }
        </dl>

        <a
          href={url}
          class="label mt-10 cta inline-flex items-center gap-2 px-5 py-3"
        >
          Visit {title}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </div>

    <nav class="border-t px-6 py-6 lg:px-8" aria-label="Programs">
      <a href="/batches" class="label hover:text-red-deep">&larr; All batches</a>
    </nav>
  </article>
</Layout>
