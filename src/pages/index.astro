---
import Layout from '@layouts/Layout.astro'
import Hero from '@components/home/Hero.astro'
import SelectedBatches from '@components/home/SelectedBatches.astro'
import BrewingNow from '@components/home/BrewingNow.astro'
import Manifesto from '@components/home/Manifesto.astro'
---

<Layout>
  <Hero />

  <!-- Batches and the lab teaser sit side by side on wide screens, as in the comps. -->
  <div class="grid lg:grid-cols-[1fr_22rem]">
    <SelectedBatches />
    <BrewingNow />
  </div>

  <Manifesto />
</Layout>
