---
import Layout from '@layouts/Layout.astro'
import { getPosts, formatDate } from '@lib/lab'

const posts = await getPosts()
---

<Layout
  title="Lab"
  description="Build logs and technical notes from the studio — what we're making and what it taught us."
>
  <section class="border-b px-6 py-12 lg:px-8 lg:py-16">
    <p class="label text-red-deep">Lab</p>
    <h1 class="display mt-3 text-[clamp(2.75rem,9vw,6rem)]">
      Notes from<br />the bench.
    </h1>
    <p class="label mt-6 max-w-[52ch] text-blue">
      Build logs and technical notes. Essays and longer writing live at{' '}
      <a href="https://markmcdermott.io" class="underline hover:text-red-deep">
        markmcdermott.io
      </a>.
    </p>
  </section>

  {
    posts.length === 0 ? (
      <p class="label px-6 py-16 lg:px-8">Nothing brewing yet. Check back.</p>
    ) : (
      <ul>
        {posts.map((post) => (
          <li class="border-b">
            <a
              href={`/lab/${post.id}`}
              class="group grid gap-2 px-6 py-8 transition-colors hover:bg-paper-tint lg:grid-cols-[9rem_1fr_auto] lg:items-baseline lg:gap-8 lg:px-8"
            >
              <time datetime={post.data.date} class="label opacity-45">
                {formatDate(post.data.date)}
              </time>

              <div class="min-w-0">
                <h2 class="display text-[clamp(1.5rem,5vw,2.25rem)]">
                  {post.data.title}
                </h2>
                {post.data.subtitle && (
                  <p class="label mt-2 max-w-[62ch] text-blue">{post.data.subtitle}</p>
                )}
                {post.data.draft && (
                  <p class="label mt-2 text-red-deep">Draft</p>
                )}
              </div>

              <span
                class="label shrink-0 transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
