---
import { render } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import RibbonHeader from '@components/RibbonHeader.astro'
import { getPosts, getListedPosts, formatLongDate } from '@lib/lab'

export async function getStaticPaths() {
  const posts = await getPosts()
  const listed = await getListedPosts()

  return posts.map((post) => {
    // The chain runs through the listed posts, so an unlisted one is stepped
    // over rather than surfaced by its neighbours — and, sitting outside the
    // run itself, has no neighbours of its own.
    const index = listed.indexOf(post)

    return {
      params: { slug: post.id },
      props: {
        post,
        // Posts are newest first, so the next one along is older.
        newer: index === -1 ? null : (listed[index - 1] ?? null),
        older: index === -1 ? null : (listed[index + 1] ?? null),
      },
    }
  })
}

const { post, newer, older } = Astro.props
const { title, subtitle, date, tags, draft, layout } = post.data
const { Content } = await render(post)
---

<Layout title={title} description={subtitle} publishedAt={date} tags={tags}>
  <article>
    <RibbonHeader as="header">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <time datetime={date} class="label opacity-45">{formatLongDate(date)}</time>
        {tags.map((tag) => <span class="label text-blue">#{tag}</span>)}
        {draft && <span class="label text-red-deep">Draft</span>}
      </div>

      {/* Article titles are arbitrary, so this sits a step below the section
          mastheads and wraps rather than being solved to a line count. */}
      <h1
        class="display display-title mt-4 max-w-none text-[clamp(1.75rem,calc(8vw_-_8px),3.6rem)] lg:text-[clamp(3.2rem,4.6vw,4.6rem)]"
      >
        {title}
      </h1>

      {subtitle && <p slot="tail" class:list={['label mt-10 text-blue lg:mt-14',layout === 'longform' ? 'max-w-none' : 'max-w-[56ch]']}>{subtitle}</p>}
                                  
    </RibbonHeader>

    <div
      class:list={[
        'prose',
        layout === 'longform' && 'prose-longform',
        'px-6 pt-10 pb-10 lg:px-8 lg:pt-14',
        layout === 'longform' ? 'lg:pb-24' : 'lg:pb-14',
      ]}
    >
      <Content />
    </div>

    <nav
      class="grid gap-4 border-t px-6 py-6 sm:grid-cols-2 lg:px-8"
      aria-label="More posts"
    >
      <div>
        {
          older && (
            <a href={`/press/${older.id}`} class="label group hover:text-red-deep">
              <span class="block opacity-45">Older</span>
              <span class="mt-1 block">&larr; {older.data.title}</span>
            </a>
          )
        }
      </div>
      <div class="sm:text-right">
        {
          newer && (
            <a href={`/press/${newer.id}`} class="label group hover:text-red-deep">
              <span class="block opacity-45">Newer</span>
              <span class="mt-1 block">{newer.data.title} &rarr;</span>
            </a>
          )
        }
      </div>
    </nav>

    <p class="border-t px-6 py-6 lg:px-8">
      <a href="/press" class="label hover:text-red-deep">&larr; All notes</a>
    </p>
  </article>
</Layout>
