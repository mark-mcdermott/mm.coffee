---
import ProgramArt from '@components/ProgramArt.astro'
import { programNumber, accentText, type Program } from '@lib/programs'

interface Props {
  program: Program
}

const { program } = Astro.props
const { title, order, tagline, stack, accent, art } = program.data
const href = `/programs/${program.id}`
---

<article class="group flex min-w-0 flex-col border-t lg:border-l lg:border-t-0">
  <a href={href} class="flex flex-1 flex-col">
    <!--
      Mobile puts the art beside the text, as in the mobile comp; from lg the
      card becomes a column with the art below the heading.
    -->
    <div
      class="grid flex-1 grid-cols-[7rem_1fr] items-start gap-4 px-6 pt-6 sm:grid-cols-[11rem_1fr] sm:gap-5 lg:flex lg:flex-col lg:gap-0 lg:px-0"
    >
      <ProgramArt
        art={art}
        class="h-28 w-full sm:h-36 lg:order-2 lg:mt-6 lg:h-44 lg:px-6"
      />

      <div class="min-w-0 lg:order-1 lg:px-6">
        <p class:list={['label', accentText(accent)]}>
          Program {programNumber(order)}
        </p>
        <!-- Titles can be one long unbreakable token (markmcdermott.io), so let
             them shrink, and break rather than push the page sideways. -->
        <h3
          class="display mt-2 break-words text-[clamp(1.15rem,5vw,1.75rem)] lg:text-[2.1rem]"
        >
          {title}
        </h3>
        <p class="label mt-3 text-blue">{tagline}</p>
      </div>
    </div>

    <div
      class="mt-6 flex min-h-[4.25rem] items-center justify-between gap-4 border-t px-6 py-4 lg:mt-auto"
    >
      <p class:list={['label', accentText(accent)]}>
        Stack: {stack.join(' / ')}
      </p>
      <span
        class="shrink-0 text-lg transition-transform group-hover:translate-x-1"
        aria-hidden="true">&rarr;</span
      >
    </div>
  </a>
</article>
