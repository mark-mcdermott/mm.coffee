---
import ProgramArt from '@components/ProgramArt.astro'
import { programNumber, accentText, type Program } from '@lib/programs'

interface Props {
  program: Program
}

const { program } = Astro.props
const { title, order, tagline, stack, accent, art } = program.data
const href = `/programs/${program.id}`
---

<article class="group flex min-w-0 flex-col border-t lg:border-l lg:border-t-0">
  <a href={href} class="flex flex-1 flex-col">
    <div class="px-6 pt-6">
      <p class:list={['label', accentText(accent)]}>
        Program {programNumber(order)}
      </p>
      <h3 class="display mt-2 text-[2.1rem]">{title}</h3>
      <p class="label mt-3 text-blue">{tagline}</p>
    </div>

    <ProgramArt art={art} class="mt-6 h-44 px-6" />

    <div
      class="mt-auto flex items-center justify-between gap-4 border-t px-6 py-4"
    >
      <p class:list={['label', accentText(accent)]}>
        Stack: {stack.join(' / ')}
      </p>
      <span
        class="text-lg transition-transform group-hover:translate-x-1"
        aria-hidden="true">&rarr;</span
      >
    </div>
  </a>
</article>
