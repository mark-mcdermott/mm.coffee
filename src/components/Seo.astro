---
import { SITE } from '@lib/site'

interface Props {
  title: string
  description: string
  canonical: string
  /** Article pages get published-time metadata and an `article` OG type. */
  publishedAt?: string
  tags?: readonly string[]
  /** Overrides the default share image. */
  image?: string
  noindex?: boolean
}

const {
  title,
  description,
  canonical,
  publishedAt,
  tags = [],
  image = '/og.png',
  noindex = false,
} = Astro.props

const imageUrl = new URL(image, SITE.url).href
const type = publishedAt ? 'article' : 'website'
---

<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta name="description" content={description} />
<meta name="author" content={SITE.author} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline} in ${SITE.location}`} />
<meta property="og:locale" content="en_GB" />

{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{publishedAt && <meta property="article:author" content={SITE.author} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.company,
    alternateName: SITE.name,
    url: SITE.url,
    logo: new URL('/icon-512.png', SITE.url).href,
    description: SITE.description,
    email: SITE.email,
    foundingDate: String(SITE.established),
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Austin',
      addressRegion: 'TX',
      addressCountry: 'US',
    },
    founder: { '@type': 'Person', name: SITE.author, url: 'https://markmcdermott.io' },
  })}
/>
