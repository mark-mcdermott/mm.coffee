---
import ProgramCard from '@components/ProgramCard.astro'
import { getPrograms } from '@lib/programs'

const programs = await getPrograms()
---

<section aria-labelledby="programs-heading">
  <a
    href="/batches"
    class="group flex items-center gap-3 px-6 py-5 hover:text-red-deep lg:px-8"
  >
    <h2 id="programs-heading" class="label">Selected programs</h2>
    <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
      &rarr;
    </span>
  </a>

  <div class="grid grid-cols-1 border-t lg:grid-cols-3">
    {programs.map((program) => <ProgramCard program={program} />)}
  </div>
</section>
