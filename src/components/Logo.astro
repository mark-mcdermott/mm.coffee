---
/**
 * mm.coffee wordmark, set in R41 Stop and shipped as outlined paths.
 * Inlined rather than <img> so it inherits colour via currentColor and costs
 * no extra request. Never swap this for a webfont.
 *
 * Variants:
 *   lockup    the primary mark — the rainbow ribbon arcs in to complete the O
 *   wordmark  flat single-colour, for reversed panels and tight spaces where
 *             the ribbon would clash or turn to mush
 *   mark      just `mm.`, for icons
 *
 * The ribbon uses palette tokens rather than its authored hexes (which differ
 * by a couple of points) so the logo and the site stay one palette.
 */
interface Props {
  variant?: 'lockup' | 'wordmark' | 'mark'
  class?: string
  title?: string
}

const { variant = 'lockup', class: className, title = 'mm.coffee' } = Astro.props

const VIEW_BOX = {
  lockup: '0 0 1041.39 288.81',
  wordmark: '0 0 1041.39 145.6',
  // Glyph advances in the wordmark: `mm.` ends at x=371.2.
  mark: '0 0 371.2 145.6',
} as const
---

