---
/**
 * MM Coffee Co wordmark, set in R41 Stop and shipped as outlined paths.
 * Inlined rather than <img> so it inherits colour via currentColor and costs
 * no extra request. Never swap this for a webfont.
 *
 * Variants:
 *   lockup    the primary mark — ribbon, name and the heart that closes it
 *   wordmark  flat single-colour, for reversed panels and tight spaces where
 *             the ribbon would clash or turn to mush
 *   mark      just `mm`, for icons
 *
 * All three are crops of the same artwork, so a variant is a `viewBox` and a
 * subset of shapes — not its own copy of the glyphs. Paths and bounds live in
 * `@lib/logo`, which the icon and share-image scripts read too.
 */
import { MONOGRAM, NAME, RIBBON, VIEW_BOX } from '@lib/logo'
import { SITE } from '@lib/site'

interface Props {
  variant?: 'lockup' | 'wordmark' | 'mark'
  class?: string
  title?: string
}

const { variant = 'lockup', class: className, title = SITE.company } = Astro.props

const letterforms = variant === 'mark' ? MONOGRAM : [...MONOGRAM, ...NAME]
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={VIEW_BOX[variant]}
  fill="currentColor"
  role="img"
  aria-label={title}
  class={className}
>
  <title>{title}</title>

  {
    /* Ribbon first so the letterforms paint over it. Its authored hexes sat a
       few points off every token, so it takes its colour from the palette
       instead — the logo and the site stay one palette by construction. */
    variant === 'lockup' &&
      RIBBON.map(({ token, d }) => <path d={d} fill={`var(--color-${token})`} />)
  }

  {letterforms.map((d) => <path d={d} />)}
</svg>
