---
import Logo from '@components/Logo.astro'
import Globe from '@components/Globe.astro'
import { NAV } from '@lib/nav'

const path = Astro.url.pathname
const isActive = (href: string) => path === href || path.startsWith(`${href}/`)
---

<header class="border-b">
  <!-- Mobile -->
  <div class="flex items-center justify-between gap-3 px-5 py-4 lg:hidden">
    <a href="/" aria-label="mm.coffee home" class="min-w-0">
      <Logo class="w-[9.6rem] text-ink sm:w-48" />
    </a>

    <div class="flex shrink-0 items-center gap-3">
      <button
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label="Open menu"
        class="flex size-9 flex-col items-center justify-center gap-[5px]"
      >
        <span class="block h-[3px] w-7 bg-ink"></span>
        <span class="block h-[3px] w-7 bg-ink"></span>
        <span class="block h-[3px] w-7 bg-ink"></span>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div
    id="nav-panel"
    hidden
    class="fixed inset-0 z-40 flex flex-col bg-paper px-5 py-4 lg:hidden"
  >
    <div class="flex items-center justify-between">
      <Logo class="w-48 text-ink" />
      <button
        type="button"
        id="nav-close"
        aria-label="Close menu"
        class="relative size-9"
      >
        <span
          class="absolute left-1 top-1/2 block h-[3px] w-7 rotate-45 bg-ink"
        ></span>
        <span
          class="absolute left-1 top-1/2 block h-[3px] w-7 -rotate-45 bg-ink"
        ></span>
      </button>
    </div>

    <nav aria-label="Main" class="mt-12">
      <ul class="space-y-6">
        {
          NAV.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'display text-5xl',
                  isActive(href) ? 'text-red-deep' : 'text-ink',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Desktop: two cells, matching the comp — [wordmark + origin] | [nav] -->
  <div class="hidden lg:grid lg:grid-cols-2 lg:items-stretch">
    <div class="flex items-center gap-8 px-8 py-6">
      <a href="/" aria-label="mm.coffee home">
        <Logo class="w-[16.8rem] text-ink" />
      </a>
      {/* The origin line is the link, not just the globe beside it — a 20px
          target was a lot to ask of anyone. `group` sits here rather than on the
          globe so the meridians turn wherever in the line the pointer is. The
          visible text says where the studio is, not where the link goes, so the
          destination is spelled out for a screen reader after it. */}
      <a
        href="/press/twenty-years-in-austin"
        class="group ml-auto flex items-end gap-3 self-end"
      >
        <p class="label">Roasted daily<br />In Austin, Texas</p>
        <Globe class="size-5" spin />
        <span class="sr-only">Read the essay: Twenty Years in Austin</span>
      </a>
    </div>

    <div class="flex items-center justify-between gap-8 border-l px-8 py-6">
      <nav aria-label="Main">
        <ul class="flex items-center gap-9">
          {
            NAV.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                  class:list={[
                    'nav-link transition-colors hover:text-red-deep',
                    isActive(href) ? 'text-red-deep' : 'text-ink',
                  ]}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle')
  const close = document.getElementById('nav-close')
  const panel = document.getElementById('nav-panel')

  if (toggle && close && panel) {
    const FOCUSABLE = 'a[href], button:not([disabled])'
    let lastFocused: HTMLElement | null = null

    const open = () => {
      lastFocused = document.activeElement as HTMLElement
      panel.hidden = false
      toggle.setAttribute('aria-expanded', 'true')
      document.body.style.overflow = 'hidden'
      panel.querySelector<HTMLElement>(FOCUSABLE)?.focus()
    }

    const shut = () => {
      panel.hidden = true
      toggle.setAttribute('aria-expanded', 'false')
      document.body.style.overflow = ''
      lastFocused?.focus()
    }

    toggle.addEventListener('click', open)
    close.addEventListener('click', shut)

    document.addEventListener('keydown', (event) => {
      if (panel.hidden) return

      if (event.key === 'Escape') {
        shut()
        return
      }

      // Keep focus inside the panel while it's open.
      if (event.key !== 'Tab') return
      const items = [...panel.querySelectorAll<HTMLElement>(FOCUSABLE)]
      if (items.length === 0) return

      const first = items[0]
      const last = items[items.length - 1]

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    })
  }
</script>
