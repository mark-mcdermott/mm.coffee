/**
 * The rainbow ribbon.
 *
 * Bands are true parallel offsets of a shared centreline — stroking one path at
 * several widths would give bands centred on the line rather than sequential
 * bands across it. Every bend is kept wider than the ribbon's half-width so the
 * inner band never pinches.
 *
 * Two curves, matching the comps:
 *   hero       four bands (mustard, brown, rust, teal), descending S
 *   manifesto  three bands (mustard, rust, brown), climbing to the right
 */
interface Props {
  variant?: 'hero' | 'manifesto'
  class?: string
  /** Mirrors the ribbon for a second placement. */
  flip?: boolean
}

