/**
 * The four-band rainbow ribbon.
 *
 * Bands are true parallel offsets of a shared centreline — stroking one path at
 * several widths would give bands centred on the line rather than sequential
 * bands across it. Every bend is kept wider than the ribbon's half-width so the
 * inner band never pinches.
 *
 * Order from the outer edge inward: gold, orange, red, blue.
 */
interface Props {
  class?: string
  /** Mirrors the ribbon for the second placement. */
  flip?: boolean
}

const { class: className, flip = false } = Astro.props

const BANDS = [
