---
/**
 * The ribbon that loops.
 *
 * Four bands run in from the left, coil once, and carry on to the right edge.
 *
 * Everything here is derived from one centre and the four band positions rather
 * than drawn. A band's straight run is tangent to the bottom of its own circle,
 * so the radius falls out of where the band sits: `R = y − CY`. That is what
 * makes the rings genuinely concentric and the bands genuinely parallel — 32
 * apart on the page and 32 apart in radius, by construction rather than by eye.
 *
 * The fold is the gap in each ring, and it is computed, not placed. A ring of
 * radius R crosses the run of every band above it twice, once either side of the
 * centre; the gap spans the left-hand crossings so the ribbon reads as passing
 * behind there, while on the right it is drawn over them and passes in front.
 * A wider ring crosses more runs and crosses them further out, which is why the
 * gaps widen with radius — and why the innermost ring, which crosses nothing,
 * needs only enough of a gap to read as the ribbon's end.
 *
 * Paint order per band, innermost first: casing, ring, run. The casing is the
 * band's stroke plus the paper that separates it from its neighbours, so an
 * outer ring carries its gap with it across everything it covers; the run goes
 * last so it closes the seam where its own ring is tangent to it.
 *
 * This replaces an Illustrator export whose arcs were polylines — 294 segments
 * in the outer band alone, three quarters of them shorter than four units,
 * which read as a chattery edge on every circle at this size. Four arcs now.
 */
interface Props {
  class?: string
}

const { class: className } = Astro.props

const WIDTH = 1855
const HEIGHT = 375.02
const CX = 1363.5
const CY = 191
const THICKNESS = 21
/** Paper between neighbouring bands, and so the width the casing adds. */
const SEPARATION = 11

/** Band centrelines, top to bottom. Their spacing is the ring spacing. */
const BANDS = [
  { token: 'gold', y: 267.5 },
  { token: 'orange', y: 299.5 },
  { token: 'red', y: 331.5 },
  { token: 'blue', y: 363.5 },
] as const

const DEG = 180 / Math.PI
const round = (n: number) => String(Math.round(n * 100) / 100)
const onCircle = (r: number, deg: number) => [
  CX + r * Math.cos(deg / DEG),
  CY + r * Math.sin(deg / DEG),
]

/**
 * The angle at which a ring of radius `r` sits `dy` below the centre, on its
 * left-hand side. Degrees clockwise from east, which is how SVG measures them
 * with y pointing down.
 */
const leftAngle = (r: number, dy: number) => DEG * Math.atan2(dy, -Math.sqrt(r * r - dy * dy))

/**
 * The angular span a ring spends inside one run — the run's full width plus the
 * paper either side of it, since the casing has to clear both. Taking the
 * crossing's centre angle and padding it is not the same thing: the ring meets a
 * run obliquely, so the span is wider on the shallow side.
 */
const crossingSpan = (r: number, y: number) => {
  // Half the run, plus half the casing sweeping across it: the gap has to clear
  // the run's edge, not its centreline, or the arc's end cap lands on the run
  // and slices a flat across it.
  const half = THICKNESS / 2 + (THICKNESS + SEPARATION) / 2
  const reach = Math.min(r, Math.abs(y + half - CY))
  const near = Math.abs(y - half - CY)
  return [leftAngle(r, reach), leftAngle(r, near)].sort((a, b) => a - b)
}

/** How far the innermost ring's own end tucks, having nothing to pass behind. */
const END_TUCK = 5

const rings = BANDS.map(({ token, y }, i) => {
  const r = y - CY
  const spans = BANDS.slice(0, i).map((band) => crossingSpan(r, band.y))
  const from = spans.length ? Math.min(...spans.map((s) => s[0])) : 137 - END_TUCK
  const to = spans.length ? Math.max(...spans.map((s) => s[1])) : 137 + END_TUCK

  const [x0, y0] = onCircle(r, to)
  const [x1, y1] = onCircle(r, from + 360)
  const sweep = from + 360 - to

  return {
    token,
    arc: `M${round(x0)},${round(y0)}A${round(r)},${round(r)} 0 ${sweep > 180 ? 1 : 0} 1 ${round(x1)},${round(y1)}`,
    // Split at the tangent point, because the two halves stack differently: the
    // ribbon passes behind the coil on the way in and in front of it on the way
    // out, which no single paint order can say.
    runIn: `M0,${round(y)}H${round(CX)}`,
    runOut: `M${round(CX)},${round(y)}H${WIDTH}`,
  }
})
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {/* Out first, so the coil is laid over it and the runs emerge from behind. */}
  {
    rings.map(({ token, runOut }) => (
      <path d={runOut} stroke={`var(--color-${token})`} stroke-width={THICKNESS} />
    ))
  }

  {/* Then the coil, innermost first, each ring carrying its own paper gap. */}
  {
    rings.map(({ token, arc }) => (
      <>
        <path d={arc} stroke="var(--color-paper)" stroke-width={THICKNESS + SEPARATION} />
        <path d={arc} stroke={`var(--color-${token})`} stroke-width={THICKNESS} />
      </>
    ))
  }

  {/* In last, so it covers where the ring's end tucks under it. */}
  {
    rings.map(({ token, runIn }) => (
      <path d={runIn} stroke={`var(--color-${token})`} stroke-width={THICKNESS} />
    ))
  }
</svg>
