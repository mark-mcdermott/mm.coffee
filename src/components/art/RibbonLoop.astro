/**
 * The ribbon that loops.
 *
 * Four bands run in from the left, coil once at the right, and carry on to the
 * edge. Each band is one continuous filled outline rather than a stroke, so the
 * coil's over-and-under is inherent to the artwork and needs no masking — the
 * paper between the bands is just background showing through, which is why this
 * only reads correctly on paper.
 *
 * Reduced from the Illustrator export's 236 shapes to these 13. The other 223
 * were sub-pixel debris from expanding the strokes — the smallest under one
 * square unit — and dropping them moves 0.3% of the rendered pixels by an
 * amount no eye resolves. The five hairline rules are kept: they patch seams
 * where the big shapes' edges don't quite meet, and removing them triples that
 * error.
 *
 * Colours come from the palette, not the export, which was a few points off
 * every token.
 *
 * The four curved paths were also refit. Illustrator had approximated the coil's
 * arcs with polylines — the outer band alone was 294 segments, 73% of them under
 * four units — which at this size reads as a chattery edge on every circle. They
 * are now cubic Béziers fitted to those points (corner-preserving, 0.12-unit
 * tolerance), which changes 0.1% of rendered samples: the facets, and nothing
 * else. The straight-edged stubs and hairline rules are left alone; they are
 * already exact, and refitting them only rounds corners meant to be sharp.
 */
interface Props {
  class?: string
}

const { class: className } = Astro.props

