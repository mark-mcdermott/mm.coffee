---
/**
 * The ribbon that loops.
 *
 * Four bands run in from the left, coil once, and carry on to the right edge.
 *
 * Everything here is derived from one center and the four band positions rather
 * than drawn. A band's straight run is tangent to the bottom of its own circle,
 * so the radius falls out of where the band sits: `R = y − CY`. That is what
 * makes the rings genuinely concentric and the bands genuinely parallel — 32
 * apart on the page and 32 apart in radius, by construction rather than by eye.
 *
 * The fold is the gap in each ring, and it is computed, not placed. A ring of
 * radius R crosses the run of every band above it twice, once either side of the
 * center; the gap spans the left-hand crossings so the ribbon reads as passing
 * behind there, while on the right it is drawn over them and passes in front.
 * A wider ring crosses more runs and crosses them further out, which is why the
 * gaps widen with radius — and why the innermost ring, which crosses nothing,
 * needs only enough of a gap to read as the ribbon's end.
 *
 * Paint order per band, innermost first: casing, ring, run. The casing is the
 * band's stroke plus the paper that separates it from its neighbours, so an
 * outer ring carries its gap with it across everything it covers; the run goes
 * last so it closes the seam where its own ring is tangent to it.
 *
 * This replaces an Illustrator export whose arcs were polylines — 294 segments
 * in the outer band alone, three quarters of them shorter than four units,
 * which read as a chattery edge on every circle at this size. Four arcs now.
 */
interface Props {
  class?: string
}

const { class: className } = Astro.props

const WIDTH = 1855
const HEIGHT = 375.02
const CX = 1363.5
const CY = 191
const THICKNESS = 21
/** Paper between neighbouring bands, and so the width the casing adds. */
const SEPARATION = 11

/** Band centerlines, top to bottom. Their spacing is the ring spacing. */
const BANDS = [
  { token: 'gold', y: 267.5 },
  { token: 'orange', y: 299.5 },
  { token: 'red', y: 331.5 },
  { token: 'blue', y: 363.5 },
] as const

const DEG = 180 / Math.PI
const round = (n: number) => String(Math.round(n * 100) / 100)
const onCircle = (r: number, deg: number) => [
  CX + r * Math.cos(deg / DEG),
  CY + r * Math.sin(deg / DEG),
]

/**
 * The cut the ribbon's ends are trimmed to: one paper-gap above the topmost
 * run, and parallel to it. Every ring stops on this line, so the four ends read
 * as one level cut rather than four slants at four heights.
 */
const CUT_Y = BANDS[0].y - THICKNESS / 2 - SEPARATION

/** Where a circle of radius `r` meets the cut, on the ribbon's left-hand side. */
const cutAngle = (r: number) => {
  const dy = CUT_Y - CY
  return DEG * Math.atan2(dy, -Math.sqrt(r * r - dy * dy))
}

/**
 * One band of the coil, as a filled sector rather than a stroked arc.
 *
 * A stroke can only end square to its own direction, which put a slanted cap on
 * the ribbon's end and left a wedge poking out of the run at the bottom. Filling
 * it means both ends are ours to place: the far end is trimmed flat along
 * `CUT_Y`, and the near end is cut radially at the tangent point, where the runs
 * cover it exactly.
 *
 * Closing the path draws the flat itself, and the inner arc carries on past it
 * to the right — which is what keeps the end reading as part of a circle rather
 * than a shape that has been sawn off.
 */
const sector = (radius: number, half: number) => {
  const outer = radius + half
  const inner = radius - half
  const from = cutAngle(outer)
  const innerFrom = cutAngle(inner)
  /** The tangent point, a full turn on, so the sweep is always the long way. */
  const to = 450

  const [ox, oy] = onCircle(outer, from)
  const [oex, oey] = onCircle(outer, to)
  const [iex, iey] = onCircle(inner, to)
  const [ix, iy] = onCircle(inner, innerFrom)

  return (
    `M${round(ox)},${round(oy)}` +
    `A${round(outer)},${round(outer)} 0 ${to - from > 180 ? 1 : 0} 1 ${round(oex)},${round(oey)}` +
    `L${round(iex)},${round(iey)}` +
    `A${round(inner)},${round(inner)} 0 ${to - innerFrom > 180 ? 1 : 0} 0 ${round(ix)},${round(iy)}` +
    'Z'
  )
}

const rings = BANDS.map(({ token, y }) => {
  const r = y - CY
  return {
    token,
    ring: sector(r, THICKNESS / 2),
    casing: sector(r, (THICKNESS + SEPARATION) / 2),
    // Split at the tangent point, because the two halves stack differently: the
    // ribbon passes behind the coil on the way in and in front of it on the way
    // out, which no single paint order can say.
    runIn: `M0,${round(y)}H${round(CX)}`,
    runOut: `M${round(CX)},${round(y)}H${WIDTH}`,
  }
})
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {/* Out first, so the coil is laid over it and the runs emerge from behind. */}
  {
    rings.map(({ token, runOut }) => (
      <path d={runOut} stroke={`var(--color-${token})`} stroke-width={THICKNESS} />
    ))
  }

  {/* Then the coil, innermost first, each ring carrying its own paper gap. */}
  {
    rings.map(({ token, ring, casing }) => (
      <>
        <path d={casing} fill="var(--color-paper)" />
        <path d={ring} fill={`var(--color-${token})`} />
      </>
    ))
  }

  {/* In last, so it covers where the ring's end tucks under it. */}
  {
    rings.map(({ token, runIn }) => (
      <path d={runIn} stroke={`var(--color-${token})`} stroke-width={THICKNESS} />
    ))
  }
</svg>
