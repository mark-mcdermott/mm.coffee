# Resend API key, used by /api/contact to send the contact form.
# Free tier: https://resend.com — 3,000 emails/month.
# Add to Vercel with: vercel env add RESEND_API_KEY
RESEND_API_KEY=

# ── /admin ────────────────────────────────────────────────────────────────
# Only needed for the deployed admin. `pnpm dev` edits the working tree and
# needs none of this — if these are unset, /admin says so instead of half
# working.
#
# From a GitHub OAuth app (Settings → Developer settings → OAuth Apps):
#   Homepage URL:              https://mm.coffee
#   Authorization callback URL: https://mm.coffee/api/admin/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts the session cookie, which carries a GitHub token. Any long random
# string: openssl rand -base64 48
SESSION_SECRET=

# The one GitHub account allowed to sign in. Everyone else is refused even
# with a valid GitHub session.
ADMIN_GITHUB_LOGIN=mark-mcdermott

# Where content is committed. GITHUB_BRANCH defaults to main.
GITHUB_REPO=mark-mcdermott/mm.coffee
GITHUB_BRANCH=main
